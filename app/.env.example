# Copy to app/.env (gitignored). The Experience server reads it at start.

# Live AI. Without it the Concierge answers simple questions with its offline planner.
# A DI-specific name, so a key or proxy inherited from another tool never carries DI traffic.
DI_ANTHROPIC_API_KEY=
# DI_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model per role (spec 23.6). Defaults shown.
# DI_MODEL_ROUTER=claude-haiku-5-5
# DI_MODEL_DEFAULT=claude-sonnet-5-5
# DI_MODEL_STRONG=claude-opus-5-5
# DI_EFFORT_ROUTER=low
# DI_EFFORT_DEFAULT=medium
# DI_EFFORT_STRONG=medium

# Voice (spec 7) through Azure AI Speech: an Azure portal "Speech service" resource's key and region.
# Without them the microphone shows why voice is off, and typing works as before.
DI_AZURE_SPEECH_KEY=
DI_AZURE_SPEECH_REGION=
# DI_AZURE_SPEECH_VOICE=en-US-AvaNeural
# DI_SPEECH_LANGUAGE=en-US

# Tenant warehouse (docker-compose.yml). Local test credentials only.
# DI_DB_URL=mysql://dinext:dinext_local@127.0.0.1:3307
# Azure Database for MySQL requires TLS: set to 1 there (deploy/azure/README.md).
# DI_DB_SSL=1

# Deployed container only: serve the built shell, and require a shared demo access code.
# DI_STATIC_DIR=apps/shell/dist
# DI_DEMO_ACCESS_CODE=

# Key for the opaque member tokens in links and context chips. The local default is for development only.
# DI_TOKEN_SECRET=

# Audit log and unmatched questions. Defaults to app/.data.
# DI_DATA_DIR=

# 1 = scripted scenarios only, no warehouse or agents.
# DI_SCRIPTED=1
